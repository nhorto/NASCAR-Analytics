{
  "name": "nascar-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backfill": "bun run src/app/index.ts backfill",
    "sync": "bun run src/app/index.ts sync",
    "status": "bun run src/app/index.ts status",
    "compute": "bun run src/app/index.ts compute",
    "serve": "bun run src/app/index.ts serve",
    "start": "bun run src/app/index.ts serve",
    "restore-drill": "bun run scripts/restore-drill.ts",
    "export": "bun run src/app/index.ts export",
    "calibrate": "bun run scripts/calibrate-strategy.ts",
    "backtest": "bun run scripts/backtest-strategy.ts",
    "capture": "bun run src/app/index.ts capture",
    "canary": "bun run src/app/index.ts canary",
    "refresh": "bun run src/app/index.ts refresh",
    "typecheck": "bunx tsc -p tsconfig.json",
    "typecheck:worker": "bunx tsc -p worker/tsconfig.json",
    "test": "bun test",
    "backtest:predictions": "bun scripts/backtest-predictions.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260705.1",
    "@types/bun": "^1.3.0"
  },
  "dependencies": {
    "hyparquet": "^1.30.0"
  }
}
